---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { SITE } from '../consts';
import {
  WEEKLY_AI_DISCLAIMER,
  WEEKLY_AUTHOR,
  buildWeeklyIssueJsonLd,
  getWeeklyTitle,
  siblingIssue,
  type WeeklyIssue,
} from '../data/weeklies';

interface Props {
  issue: WeeklyIssue;
}

const { issue } = Astro.props;
const title = getWeeklyTitle(issue.titleId);
const jsonLd = buildWeeklyIssueJsonLd(issue, title, SITE.url);
const sibling = siblingIssue(issue);
const siblingTitle = sibling ? getWeeklyTitle(sibling.titleId) : undefined;
const base = import.meta.env.BASE_URL;
const pdfHref = `${base}${issue.pdfPath}`;
---

<BaseLayout
  title={`${title.name}: ${issue.headline} | Causewave`}
  description={issue.description}
  ogTitle={`${title.name}: ${issue.headline}`}
  ogDescription={issue.dek}
  ogImage={title.ogImage}
  ogImageAlt={title.ogImageAlt}
  canonicalPath={issue.path}
  ogType="article"
  breadcrumbLabel={`${title.name} · ${issue.dateLabel}`}
  breadcrumbParent={{ name: 'Weekly', path: 'weekly/' }}
  jsonLd={jsonLd}
>
  <main>
    <section class="bg-slate-900 text-white section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="max-w-3xl">
          <a href={`${base}weekly/`} class="inline-flex items-center text-sm text-slate-400 hover:text-white transition-colors mb-6">
            ← Sunday weeklies
          </a>
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-xs font-medium text-amber-300 bg-amber-400/10 px-2.5 py-0.5 rounded-full">
              Prepared end to end by AI
            </span>
            <span class="text-xs font-medium text-sky-400 bg-sky-400/10 px-2.5 py-0.5 rounded-full">
              {title.name}
            </span>
            <span class="text-xs text-slate-500">{issue.volume} · {issue.number}</span>
            <span class="text-xs text-slate-500">{issue.dateLabel}</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">{issue.headline}</h1>
          <p class="mt-4 text-slate-300 text-lg">{issue.dek}</p>
          <p class="mt-3 text-sm text-slate-400">{title.masthead}</p>
        </div>
      </div>
    </section>

    <article class="section max-w-screen-2xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 mb-8">
          <div class="text-xs font-semibold tracking-widest text-amber-800 mb-1">AI-PREPARED SUNDAY REVIEW</div>
          <p class="text-sm text-amber-950 leading-relaxed">
            {WEEKLY_AI_DISCLAIMER} This is a newspaper-style weekly, not a numbered insight series. The PDF is the issue.
          </p>
        </div>

        <p class="text-slate-600 leading-relaxed mb-6">{issue.excerpt}</p>

        <h2 class="text-2xl font-semibold mt-8 mb-4">In this issue</h2>
        <ul class="space-y-3 text-slate-600 mb-8">
          {issue.highlights.map((item) => (
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-2 shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <blockquote class="border-l-4 border-slate-900 pl-5 py-1 mb-10">
          <p class="text-lg text-slate-800 leading-relaxed">“{issue.quote.text}”</p>
          <footer class="mt-2 text-sm text-slate-500">— {issue.quote.attribution}</footer>
        </blockquote>

        <div class="flex flex-wrap gap-3 mb-6">
          <a
            href={pdfHref}
            download
            class="inline-flex items-center px-5 py-2.5 bg-slate-900 text-white rounded-full text-sm font-semibold hover:bg-sky-600 transition-all"
          >
            Download PDF
            <Icon name="arrow-right" class="w-4 h-4 ml-2" />
          </a>
          <a
            href={pdfHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-5 py-2.5 border border-slate-300 rounded-full text-sm font-semibold text-slate-800 hover:border-sky-400 hover:text-sky-700 transition-all"
          >
            Open PDF
          </a>
          <a
            href={issue.linkedInUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-5 py-2.5 border border-slate-300 rounded-full text-sm font-semibold text-slate-800 hover:border-sky-400 hover:text-sky-700 transition-all"
          >
            LinkedIn post
          </a>
        </div>

        <p class="text-xs text-slate-500 mb-4">
          {title.name} · {issue.volume} · {issue.number} · {issue.pageCount} {issue.pageCount === 1 ? 'page' : 'pages'} · {WEEKLY_AUTHOR.name}
        </p>

        <div class="rounded-2xl border overflow-hidden bg-slate-100 mb-4">
          <iframe
            src={`${pdfHref}#view=FitH`}
            title={`${title.name} ${issue.volume} ${issue.number} PDF`}
            class="w-full h-[min(90vh,1100px)] bg-white"
          ></iframe>
        </div>
        <p class="text-sm text-slate-500 mb-10">
          If the viewer is blank on this device,
          <a href={pdfHref} class="text-sky-600 hover:underline font-semibold">download the PDF</a>.
        </p>

        <div class="rounded-2xl border border-dashed bg-slate-50 p-6 mb-8">
          <div class="text-xs font-semibold text-slate-500 tracking-widest mb-2">NEXT ISSUE</div>
          <p class="text-sm text-slate-600 leading-relaxed">{issue.nextIssueLabel}</p>
        </div>

        {sibling && siblingTitle && (
          <a
            href={`${base}${sibling.path}`}
            class="block rounded-2xl border bg-white p-6 hover:border-sky-300 hover:-translate-y-0.5 transition-all mb-8"
          >
            <div class="flex items-center gap-3 mb-2">
              <span class="text-xs font-semibold text-sky-600 bg-sky-50 px-2.5 py-0.5 rounded-full">
                Same Sunday
              </span>
              <span class="text-xs text-slate-500">{siblingTitle.name}</span>
            </div>
            <h2 class="text-xl font-semibold tracking-tight text-slate-900">{sibling.headline}</h2>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{sibling.dek}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-sky-600">Read {siblingTitle.name} →</span>
          </a>
        )}

        <p class="text-sm text-slate-500 leading-relaxed">
          Authored data series live on
          <a href={`${base}insights/`} class="text-sky-600 hover:underline">Insights</a>.
        </p>
      </div>
    </article>
  </main>
</BaseLayout>

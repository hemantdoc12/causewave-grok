---
import type { InsightSeries, SeriesPart } from '../data/series';

interface Props {
  series: InsightSeries;
  current: SeriesPart;
  prev?: SeriesPart;
  next?: SeriesPart;
}

const { series, current, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="rounded-2xl border bg-slate-50 p-5 md:p-6 mb-10">
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold tracking-widest text-sky-600 mb-2">
    <a href={`${base}${series.path}`} class="hover:underline">SERIES</a>
    <span class="text-slate-300">·</span>
    <span>{series.name}</span>
    <span class="text-slate-300">·</span>
    <span>Part {current.part} of {series.parts.length}</span>
  </div>
  <p class="text-sm text-slate-600 mb-4">
    <a href={`${base}${series.path}`} class="font-medium text-slate-800 hover:text-sky-600">
      View full series →
    </a>
  </p>
  <div class="flex flex-col sm:flex-row gap-3">
    {prev ? (
      <a
        href={`${base}${prev.path}`}
        class="flex-1 rounded-xl border bg-white px-4 py-3 text-sm hover:border-sky-300 transition-colors"
      >
        <div class="text-xs text-slate-500 mb-1">← Previous</div>
        <div class="font-medium text-slate-800">Part {prev.part}: {prev.shortTitle}</div>
      </a>
    ) : (
      <div class="flex-1 rounded-xl border border-dashed px-4 py-3 text-sm text-slate-400">
        <div class="text-xs mb-1">Previous</div>
        Start of series
      </div>
    )}
    {next ? (
      <a
        href={`${base}${next.path}`}
        class="flex-1 rounded-xl border bg-white px-4 py-3 text-sm hover:border-sky-300 transition-colors text-right sm:text-left"
      >
        <div class="text-xs text-slate-500 mb-1">Next →</div>
        <div class="font-medium text-slate-800">Part {next.part}: {next.shortTitle}</div>
      </a>
    ) : (
      <div class="flex-1 rounded-xl border border-dashed px-4 py-3 text-sm text-slate-400">
        <div class="text-xs mb-1">Next</div>
        {series.upcoming ? 'Part 4 coming soon' : 'End of published parts'}
      </div>
    )}
  </div>
</div>

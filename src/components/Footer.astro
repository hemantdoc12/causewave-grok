---
import { CONTACT } from '../consts';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const phoneHref = CONTACT.phone.replace(/\s/g, '');
---

<footer class="bg-slate-900 text-slate-400 text-xs">
  <div class="max-w-screen-2xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 pb-6 border-b border-slate-800">
      <div>
        <div class="text-sm font-semibold text-slate-200 mb-1">Causewave Innovations LLP</div>
        <p class="text-slate-500 max-w-sm leading-relaxed">
          CSR consulting firm in India — strategy, programme design, impact measurement, and compliance for corporates and partners.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-8">
        <a href={`mailto:${CONTACT.email}`} class="hover:text-slate-200 transition-colors">
          {CONTACT.email}
        </a>
        <a href={`tel:${phoneHref}`} class="hover:text-slate-200 transition-colors">
          {CONTACT.phone}
        </a>
        <span class="text-slate-500">{CONTACT.location}</span>
      </div>
    </div>
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-y-2">
      <div class="text-slate-500">&copy; {year} Causewave Innovations LLP. All rights reserved.</div>
      <div class="flex gap-x-4">
        <a href={`${base}privacy-policy/`} class="hover:text-slate-200 transition-colors">Privacy</a>
        <a href={`${base}terms-of-service/`} class="hover:text-slate-200 transition-colors">Terms</a>
        <span class="text-slate-500">Made in India</span>
      </div>
    </div>
  </div>
</footer>

---
import { SITE, CONTACT } from '../consts';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-500 text-xs">
  <div class="max-w-screen-2xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-y-2">
    <div>&copy; {year} Causewave Innovations LLP. All rights reserved.</div>
    <div class="flex gap-x-4">
      <a href={`${base}privacy-policy/`} class="hover:text-slate-300 transition-colors">Privacy</a>
      <a href={`${base}terms-of-service/`} class="hover:text-slate-300 transition-colors">Terms</a>
      <span>Made in India</span>
    </div>
  </div>
</footer>

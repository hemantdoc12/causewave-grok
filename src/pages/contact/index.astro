---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT } from '../../consts';
const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="Contact | Causewave" 
  description="Get in touch with Causewave. Let's discuss how we can help you build CSR programs that actually work."
  activePage="contact"
>
  <main>
    <!-- Hero -->
    <section class="bg-slate-900 text-white section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="max-w-3xl">
          <span class="text-sky-400 font-semibold text-sm tracking-widest">GET IN TOUCH</span>
          <h1 class="hero-animate mt-3 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter leading-tight">
            Let's talk about your CSR goals
          </h1>
          <p class="hero-animate hero-animate-delay-1 mt-5 text-lg text-slate-300 max-w-2xl">
            Whether you're starting from scratch or looking to optimize existing programs, we're here to help.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="grid md:grid-cols-5 gap-12">
        <!-- Form -->
        <div class="md:col-span-3 reveal">
          <h2 class="text-2xl font-semibold mb-6">Send us a message</h2>
          <form class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Full Name *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
                  placeholder="you@company.com"
                />
              </div>
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-slate-700 mb-1">Company</label>
              <input 
                type="text" 
                id="company" 
                name="company"
                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
                placeholder="Your company name"
              />
            </div>
            <div>
              <label for="budget" class="block text-sm font-medium text-slate-700 mb-1">CSR Budget Range</label>
              <select 
                id="budget" 
                name="budget"
                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
              >
                <option value="">Select a range</option>
                <option value="under-50">Under ₹50 Lakh</option>
                <option value="50-200">₹50 Lakh — ₹2 Crore</option>
                <option value="200-500">₹2 Crore — ₹5 Crore</option>
                <option value="500-1000">₹5 Crore — ₹10 Crore</option>
                <option value="above-1000">Above ₹10 Crore</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Message *</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required
                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 resize-none"
                placeholder="Tell us about your CSR goals or questions..."
              ></textarea>
            </div>
            <button type="submit" class="btn btn-primary px-8 py-3 text-sm">
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Details -->
        <div class="md:col-span-2 reveal">
          <h2 class="text-2xl font-semibold mb-6">Contact details</h2>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
                <i class="fa-solid fa-envelope text-lg"></i>
              </div>
              <div>
                <div class="font-medium text-sm">Email</div>
                <a href={`mailto:${CONTACT.email}`} class="text-slate-600 text-sm hover:text-sky-600 transition-colors">{CONTACT.email}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
                <i class="fa-solid fa-phone text-lg"></i>
              </div>
              <div>
                <div class="font-medium text-sm">Phone</div>
                <a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`} class="text-slate-600 text-sm hover:text-sky-600 transition-colors">{CONTACT.phone}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
                <i class="fa-solid fa-location-dot text-lg"></i>
              </div>
              <div>
                <div class="font-medium text-sm">Location</div>
                <span class="text-slate-600 text-sm">{CONTACT.location}</span>
              </div>
            </div>
          </div>

          <div class="mt-8 rounded-2xl bg-slate-50 p-6">
            <h3 class="font-semibold mb-2">Office hours</h3>
            <p class="text-sm text-slate-600">
              Monday — Friday: 9:00 AM — 6:00 PM IST<br/>
              Saturday: 10:00 AM — 2:00 PM IST
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

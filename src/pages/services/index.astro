---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="Services | Causewave" 
  description="End-to-end CSR support — from strategy and compliance to program design, implementation, and impact measurement."
  activePage="services"
>
  <main>
    <!-- Hero -->
    <section class="bg-slate-900 text-white section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="max-w-3xl">
          <span class="text-sky-400 font-semibold text-sm tracking-widest">OUR SERVICES</span>
          <h1 class="hero-animate mt-3 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter leading-tight">
            End-to-end CSR support
          </h1>
          <p class="hero-animate hero-animate-delay-1 mt-5 text-lg text-slate-300 max-w-2xl">
            From initial strategy through to measurable community impact — we handle the full program cycle so you can focus on your core business.
          </p>
        </div>
      </div>
    </section>

    <!-- Services Detail -->
    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="space-y-16">

        <!-- Service 1: CSR Strategy & Compliance -->
        <div class="grid md:grid-cols-2 gap-10 items-start reveal">
          <div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-sky-100 text-sky-600 mb-5">
              <i class="fa-solid fa-handshake text-3xl"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">CSR Strategy & Compliance</h2>
            <p class="mt-4 text-slate-600 leading-relaxed">
              Navigate the complexities of CSR regulations with confidence. We help you build strategies that satisfy statutory requirements, board expectations, and community needs — all at once.
            </p>
            <ul class="mt-5 space-y-3 text-sm text-slate-600">
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-sky-500 mt-0.5"></i>
                <span>CSR policy development and alignment with Companies Act 2013</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-sky-500 mt-0.5"></i>
                <span>Priority mapping based on stakeholder needs and business context</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-sky-500 mt-0.5"></i>
                <span>Action plans with clear timelines, budgets, and KPIs</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-sky-500 mt-0.5"></i>
                <span>Board-ready reporting frameworks and compliance documentation</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-sky-500 mt-0.5"></i>
                <span>Annual CSR disclosure and impact report preparation</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl bg-slate-50 p-8">
            <h3 class="font-semibold text-lg mb-4">Who it's for</h3>
            <p class="text-sm text-slate-600 mb-6">
              Companies newly mandating CSR, those upgrading their compliance frameworks, or organizations seeking strategic alignment between business goals and social impact.
            </p>
            <h3 class="font-semibold text-lg mb-4">Expected outcomes</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                100% CSR compliance readiness
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                Clear 3-year CSR roadmap
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                Board-approved action plan
              </li>
            </ul>
          </div>
        </div>

        <!-- Service 2: Program Design & Budgeting -->
        <div class="grid md:grid-cols-2 gap-10 items-start reveal">
          <div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-100 text-teal-600 mb-5">
              <i class="fa-solid fa-sitemap text-3xl"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Program Design & Budgeting</h2>
            <p class="mt-4 text-slate-600 leading-relaxed">
              Design CSR initiatives that actually work on the ground. We create practical programs across health, education, livelihoods, and sustainability — with measurable outputs from day one.
            </p>
            <ul class="mt-5 space-y-3 text-sm text-slate-600">
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-teal-500 mt-0.5"></i>
                <span>Need assessments and community profiling</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-teal-500 mt-0.5"></i>
                <span>Program design across focus areas (health, education, livelihoods, environment)</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-teal-500 mt-0.5"></i>
                <span>Budget planning with cost-efficiency benchmarks</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-teal-500 mt-0.5"></i>
                <span>Implementation roadmaps with milestone tracking</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-teal-500 mt-0.5"></i>
                <span>Partner selection and vendor management support</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl bg-slate-50 p-8">
            <h3 class="font-semibold text-lg mb-4">Who it's for</h3>
            <p class="text-sm text-slate-600 mb-6">
              Companies with CSR budgets to deploy, those transitioning from ad-hoc donations to structured programs, or organizations looking to maximize impact per rupee spent.
            </p>
            <h3 class="font-semibold text-lg mb-4">Expected outcomes</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
                Detailed program design document
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
                Optimized budget allocation
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
                Clear implementation roadmap
              </li>
            </ul>
          </div>
        </div>

        <!-- Service 3: Impact Measurement & Reporting -->
        <div class="grid md:grid-cols-2 gap-10 items-start reveal">
          <div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600 mb-5">
              <i class="fa-solid fa-chart-line text-3xl"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Impact Measurement & Reporting</h2>
            <p class="mt-4 text-slate-600 leading-relaxed">
              Prove your impact with credible data. We build monitoring frameworks, collect field data, and produce reports that satisfy regulators, boards, and communities alike.
            </p>
            <ul class="mt-5 space-y-3 text-sm text-slate-600">
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                <span>M&E framework design aligned with global standards</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                <span>Field data collection and quality assurance</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                <span>Data analysis, visualization, and insight generation</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                <span>Board-ready impact reports and dashboards</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                <span>Third-party audit support and certification</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl bg-slate-50 p-8">
            <h3 class="font-semibold text-lg mb-4">Who it's for</h3>
            <p class="text-sm text-slate-600 mb-6">
              Companies needing to demonstrate CSR impact to regulators, organizations seeking ESG ratings improvement, or teams that want data-driven insights for program optimization.
            </p>
            <h3 class="font-semibold text-lg mb-4">Expected outcomes</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Robust M&E framework
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Quarterly impact dashboards
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Annual impact report
              </li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <!-- Process Section -->
    <section class="section bg-white">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="text-center mb-10 reveal">
          <span class="text-sky-600 font-semibold text-sm tracking-widest">HOW WE WORK</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Our process</h2>
        </div>

        <div class="grid md:grid-cols-4 gap-6 reveal-stagger">
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-sky-100 text-sky-600 font-semibold text-lg">1</div>
            <h3 class="mt-4 font-semibold">Discover</h3>
            <p class="mt-2 text-sm text-slate-600">Understand your business context, CSR obligations, and community needs.</p>
          </div>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-teal-100 text-teal-600 font-semibold text-lg">2</div>
            <h3 class="mt-4 font-semibold">Design</h3>
            <p class="mt-2 text-sm text-slate-600">Create tailored programs with clear goals, budgets, and implementation plans.</p>
          </div>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-semibold text-lg">3</div>
            <h3 class="mt-4 font-semibold">Deliver</h3>
            <p class="mt-2 text-sm text-slate-600">Implement programs with on-ground teams and real-time progress tracking.</p>
          </div>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-sky-100 text-sky-600 font-semibold text-lg">4</div>
            <h3 class="mt-4 font-semibold">Demonstrate</h3>
            <p class="mt-2 text-sm text-slate-600">Measure impact, generate reports, and prove compliance to all stakeholders.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section bg-slate-900 text-white">
      <div class="max-w-screen-2xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight reveal">
          Ready to build CSR programs that actually work?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto reveal">
          Let's discuss how Causewave can help you deliver compliant, measurable, and community-trusted CSR initiatives.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center reveal">
          <a href={`${base}contact/`} class="btn btn-primary px-8 py-3 text-base bg-white text-slate-900 hover:bg-slate-100">
            Book a Strategy Call
          </a>
          <a href={`${base}about/`} class="btn btn-outline border-white/40 text-white px-8 py-3 text-base hover:bg-white/10">
            Learn About Us →
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

---
import { SITE } from '../../../consts';
import { AI_VIDEO } from '../../../data/ai-video';

const base = import.meta.env.BASE_URL;
const destPath = `${base}${AI_VIDEO.path}`;
const destCanonical = `${SITE.url}${AI_VIDEO.path}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI video has moved | Causewave</title>
    <link rel="canonical" href={destCanonical} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destPath}`} />
  </head>
  <body>
    <p>This page has moved to <a href={destPath}>causewave.in/ai-video/</a>.</p>
    <script define:vars={{ destPath }}>
      window.location.replace(destPath + window.location.search + window.location.hash);
    </script>
  </body>
</html>

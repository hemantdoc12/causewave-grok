---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SEO } from '../../consts';
const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title={SEO.about.title}
  description={SEO.about.description}
  ogTitle={SEO.about.ogTitle}
  ogDescription={SEO.about.ogDescription}
  canonicalPath="about/"
  activePage="about"
  breadcrumbLabel="About"
>
  <main>
    <!-- Hero -->
    <section class="bg-slate-900 text-white section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="max-w-3xl">
          <span class="text-sky-400 font-semibold text-sm tracking-widest">CSR & IMPACT CONSULTING FIRM · INDIA</span>
          <h1 class="hero-animate mt-3 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter leading-tight">
            Bridging CSR compliance and real community impact
          </h1>
          <p class="hero-animate hero-animate-delay-1 mt-5 text-lg text-slate-300 max-w-2xl">
            Causewave is an India-based impact and CSR consulting firm. We help corporates design social impact programmes that are compliant, measurable, and trusted by communities.
          </p>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-sky-600 font-semibold text-sm tracking-widest">OUR STORY</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">
            18+ years of public health leadership
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Causewave was founded on a simple observation: corporate social responsibility programmes often fail at the intersection of compliance and community trust. Companies struggle with regulations; communities struggle with programmes that do not address real needs.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            With over 18 years of experience in public health leadership — including managing vaccination drives that delivered 33 lakh+ doses in a single day — we bring field-tested expertise to every CSR strategy, programme design, and impact measurement engagement.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Today, we work with companies and partners across India on CSR consulting that satisfies regulators, impresses boards, and creates measurable community impact — especially in healthcare and last-mile delivery.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-sky-600">18+</div>
            <div class="mt-1 text-sm font-medium text-slate-600">Years of Experience</div>
          </div>
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-teal-600">33 Lakh+</div>
            <div class="mt-1 text-sm font-medium text-slate-600">Vaccination Doses in a Day</div>
          </div>
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-emerald-600">5+</div>
            <div class="mt-1 text-sm font-medium text-slate-600">States Across India</div>
          </div>
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-sky-600">SKOCH</div>
            <div class="mt-1 text-sm font-medium text-slate-600">Gold Award Winner</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="section bg-white">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="text-center mb-10">
          <span class="text-sky-600 font-semibold text-sm tracking-widest">OUR MISSION</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">What drives us</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="rounded-2xl border bg-white p-6">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
              <Icon name="bullseye" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-semibold">Compliance Without Compromise</h3>
            <p class="mt-2 text-sm text-slate-600">
              We believe compliance shouldn't come at the cost of impact. Our programs satisfy regulators while creating real change in communities.
            </p>
          </div>

          <div class="rounded-2xl border bg-white p-6">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
              <Icon name="users" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-semibold">Community-First Design</h3>
            <p class="mt-2 text-sm text-slate-600">
              Every program starts with understanding community needs. We don't believe in one-size-fits-all solutions — context matters.
            </p>
          </div>

          <div class="rounded-2xl border bg-white p-6">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
              <Icon name="chart-bar" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-semibold">Data-driven Decisions</h3>
            <p class="mt-2 text-sm text-slate-600">
              We measure everything. From field data to board reports, our programs are built on evidence, not assumptions.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Expertise Section -->
    <section class="section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="text-center mb-10">
          <span class="text-sky-600 font-semibold text-sm tracking-widest">OUR EXPERTISE</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Core strengths</h2>
          <p class="mt-3 text-slate-600 max-w-2xl mx-auto">Deep domain expertise in key areas, backed by 18+ years of on-ground implementation.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4 rounded-2xl bg-white border p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
              <Icon name="heart-pulse" class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-semibold">Public Health</h3>
              <p class="mt-1 text-sm text-slate-600">Vaccination drives, healthcare access, maternal health, and disease prevention programs.</p>
            </div>
          </div>

          <div class="flex gap-4 rounded-2xl bg-white border p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
              <Icon name="graduation-cap" class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-semibold">Education</h3>
              <p class="mt-1 text-sm text-slate-600">School infrastructure, digital literacy, scholarship programs, and teacher training.</p>
            </div>
          </div>

          <div class="flex gap-4 rounded-2xl bg-white border p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
              <Icon name="seedling" class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-semibold">Livelihoods</h3>
              <p class="mt-1 text-sm text-slate-600">Skill development, micro-enterprise support, women's empowerment, and rural livelihoods.</p>
            </div>
          </div>

          <div class="flex gap-4 rounded-2xl bg-white border p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
              <Icon name="leaf" class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-semibold">Environment</h3>
              <p class="mt-1 text-sm text-slate-600">Water conservation, waste management, renewable energy, and climate resilience.</p>
            </div>
          </div>
        </div>

        <div class="mt-10 text-center">
          <p class="text-sm font-medium text-slate-500 mb-4">AND ACROSS ALL SCHEDULE VII CSR AREAS</p>
          <div class="flex flex-wrap justify-center gap-2">
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Healthcare</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Education</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Livelihood Enhancement</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Environment</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Gender Equality</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Child Welfare</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Senior Citizens</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Disability Inclusion</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Rural Development</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Tribal Welfare</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Clean Ganga</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Art & Culture</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Sports</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Technology</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">Disaster Relief</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-600">And more</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SEO } from '../../consts';
import {
  WEEKLY_AI_DISCLAIMER,
  WEEKLY_TITLES,
  latestIssue,
} from '../../data/weeklies';

const base = import.meta.env.BASE_URL;
const titles = WEEKLY_TITLES.map((title) => ({
  title,
  issue: latestIssue(title.id),
}));
---

<BaseLayout
  title={SEO.weekly.title}
  description={SEO.weekly.description}
  ogTitle={SEO.weekly.ogTitle}
  ogDescription={SEO.weekly.ogDescription}
  ogImage="images/og/weekly-impact.jpg"
  ogImageAlt="Sunday newspaper and CSR filings on a desk"
  canonicalPath="weekly/"
  breadcrumbLabel="Weekly"
>
  <main>
    <section class="bg-slate-900 text-white section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center">
          <span class="text-amber-300 font-semibold text-sm tracking-widest">SUNDAY WEEKLIES · PREPARED END TO END BY AI</span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tighter leading-tight">
            Two Sunday reviews, labelled as AI-prepared
          </h1>
          <p class="mt-5 text-lg text-slate-300">
            Impact Weekly reads India’s CSR week. AI Health Weekly grades the week’s evidence on AI in health. Both are full AI-prepared outputs. The editorial is Dr. Hemant L. Patel.
          </p>
          <p class="mt-4 text-sm text-slate-400">
            {WEEKLY_AI_DISCLAIMER} They sit apart from the authored insight series.
          </p>
        </div>
      </div>
    </section>

    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {titles.map(({ title, issue }) => (
          <article class="bg-white border rounded-2xl overflow-hidden hover:-translate-y-1 transition-all flex flex-col">
            <div class={`bg-gradient-to-br ${title.cardTone} p-5 text-white`}>
              <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">
                {title.tagline}
              </span>
              <h2 class="text-xl font-semibold leading-snug">{title.name}</h2>
              <p class="mt-2 text-sm text-white/90">{title.masthead}</p>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
                <span class="font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 rounded-full">AI-prepared</span>
                <span>{issue.volume} · {issue.number}</span>
                <span>•</span>
                <span>{issue.dateLabel}</span>
              </div>
              <h3 class="text-lg font-semibold tracking-tight text-slate-900">{issue.headline}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{issue.dek}</p>
              <div class="mt-5 flex flex-wrap gap-3">
                <a
                  href={`${base}${issue.path}`}
                  class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700"
                >
                  Read this issue <Icon name="arrow-right" class="w-3.5 h-3.5 ml-1" />
                </a>
                <a
                  href={`${base}${issue.pdfPath}`}
                  class="inline-flex items-center text-slate-500 text-sm font-semibold hover:text-slate-800"
                >
                  PDF
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="max-w-3xl mx-auto mt-12 text-center">
        <h2 class="text-xl font-semibold tracking-tight mb-3">How to read these</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          The PDF is the issue — layout, tables, and sourcing stay in the newspaper. The web page is the landing: headline, what changed, download, and the AI label. Authored essays and numbered data series remain on
          <a href={`${base}insights/`} class="text-sky-600 hover:underline font-semibold">Insights</a>.
        </p>
        <p class="mt-4 text-sm text-slate-500">Next issues: Sunday, 18 October 2026.</p>
      </div>
    </section>
  </main>
</BaseLayout>

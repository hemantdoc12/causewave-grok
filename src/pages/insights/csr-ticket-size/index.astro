---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CSR_TICKET_SIZE_SERIES } from '../../../data/series';

const base = import.meta.env.BASE_URL;
const series = CSR_TICKET_SIZE_SERIES;
---

<BaseLayout
  title="CSR Ticket Size Series | Causewave Insights"
  description={series.description}
  ogTitle="CSR Ticket Size — A Data Series on India’s CSR Cheque Economics"
  ogDescription="Why average CSR project size stays near ₹35 lakh, who concentrates vs sprays, and which sectors run fat or thin tickets — from National CSR Portal filings."
  canonicalPath={series.path}
  activePage="insights"
  breadcrumbLabel={series.name}
  breadcrumbParent={{ name: 'Insights', path: 'insights/' }}
>
  <main>
    <section class="bg-slate-900 text-white section">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="max-w-3xl">
          <a href={`${base}insights/`} class="inline-flex items-center text-sm text-slate-400 hover:text-white transition-colors mb-6">
            ← Back to Insights
          </a>
          <span class="text-sky-400 font-semibold text-sm tracking-widest">DATA SERIES</span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tighter leading-tight">
            {series.name}
          </h1>
          <p class="mt-5 text-lg text-slate-300 max-w-2xl">
            {series.description}
          </p>
          <p class="mt-4 text-sm text-slate-400">
            By Dr. Hemant L. Patel · National CSR Portal filings, FY 2014-15 to FY 2024-25
          </p>
        </div>
      </div>
    </section>

    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="max-w-3xl space-y-4">
        {series.parts.map((part) => (
          <a
            href={`${base}${part.path}`}
            class="block rounded-2xl border bg-white p-6 hover:border-sky-300 hover:-translate-y-0.5 transition-all"
          >
            <div class="flex items-center gap-3 mb-2">
              <span class="text-xs font-semibold text-sky-600 bg-sky-50 px-2.5 py-0.5 rounded-full">
                Part {part.part}
              </span>
              <span class="text-xs text-slate-500">{part.dateLabel}</span>
            </div>
            <h2 class="text-xl font-semibold tracking-tight text-slate-900">{part.title}</h2>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{part.excerpt}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-sky-600">Read part {part.part} →</span>
          </a>
        ))}

        {series.upcoming && (
          <div class="rounded-2xl border border-dashed bg-slate-50 p-6">
            <div class="text-xs font-semibold text-slate-500 tracking-widest mb-2">COMING NEXT</div>
            <p class="text-sm text-slate-600 leading-relaxed">{series.upcoming}</p>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

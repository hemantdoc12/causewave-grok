---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout activePage="home">
  <main>
    <!-- Hero -->
    <section class="section bg-slate-900 text-white">
      <div class="max-w-screen-2xl mx-auto px-6 text-center">
        <div class="max-w-3xl mx-auto">
          <h1 class="text-5xl md:text-6xl font-semibold tracking-tighter mb-6">
            CSR Programs That<br />
            <span class="text-sky-400">Actually Work</span>
          </h1>
          <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-8">
            From strategy to community impact — we build programs that satisfy boards, regulators, and the people they serve.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`${base}services/`} class="btn btn-primary px-8 py-3.5 text-base">
              Explore Services
            </a>
            <a href={`${base}contact/`} class="btn btn-outline border-white/30 text-white px-8 py-3.5 text-base hover:bg-white/10">
              Book a Strategy Call
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-white border-b">
      <div class="max-w-screen-2xl mx-auto px-6 py-8">
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="text-4xl font-semibold text-sky-600">50+</div>
            <div class="mt-1 text-sm text-slate-600">Happy Clients</div>
          </div>
          <div>
            <div class="text-4xl font-semibold text-teal-600">₹10 Crore+</div>
            <div class="mt-1 text-sm text-slate-600">CSR Impact Generated</div>
          </div>
          <div>
            <div class="text-4xl font-semibold text-emerald-600">100%</div>
            <div class="mt-1 text-sm text-slate-600">Compliance Success</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Preview -->
    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="text-center mb-10">
        <span class="text-sky-600 font-semibold text-sm tracking-widest">WHAT WE DELIVER</span>
        <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">CSR support across the full program cycle</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <a href={`${base}services/`} class="card group block rounded-2xl border bg-white p-6 hover:border-sky-200">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
            <i class="fa-solid fa-handshake text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold">CSR Strategy & Compliance</h3>
          <p class="mt-2 text-sm text-slate-600">Shape priorities, action plans, and reporting readiness aligned with statutory and board expectations.</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-sky-600 group-hover:underline">
            Learn more →
          </span>
        </a>

        <a href={`${base}services/`} class="card group block rounded-2xl border bg-white p-6 hover:border-teal-200">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
            <i class="fa-solid fa-sitemap text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold">Program Design & Budgeting</h3>
          <p class="mt-2 text-sm text-slate-600">Design practical CSR initiatives across health, education, livelihoods, and sustainability with measurable outputs.</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-teal-600 group-hover:underline">
            Learn more →
          </span>
        </a>

        <a href={`${base}services/`} class="card group block rounded-2xl border bg-white p-6 hover:border-emerald-200">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
            <i class="fa-solid fa-chart-line text-2xl"></i>
          </div>
          <h3 class="text-xl font-semibold">Impact Measurement & Reporting</h3>
          <p class="mt-2 text-sm text-slate-600">Build credible M&E frameworks, collect field data, and produce board-ready impact reports.</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-emerald-600 group-hover:underline">
            Learn more →
          </span>
        </a>
      </div>

      <div class="mt-8 text-center">
        <a href={`${base}services/`} class="btn btn-primary px-6 py-3 text-sm">
          View All Services →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>


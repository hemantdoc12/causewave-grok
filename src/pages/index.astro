---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SEO } from '../consts';
const base = import.meta.env.BASE_URL;

// WebSite entity only — no SearchAction until a real /search route exists
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Causewave",
  "url": SITE.url,
  "description": SITE.description,
  "publisher": {
    "@type": "Organization",
    "name": "Causewave Innovations LLP",
    "url": SITE.url,
  },
};
---

<BaseLayout 
  title={SEO.home.title}
  description={SEO.home.description}
  ogTitle={SEO.home.ogTitle}
  ogDescription={SEO.home.ogDescription}
  ogImage="images/og/home.jpg"
  ogImageAlt="Aerial view of farmland and a city skyline along a river — CSR consulting across India"
  activePage="home" 
  canonicalPath=""
  jsonLd={websiteJsonLd}
>
  <main>
    <!-- Hero -->
    <header 
      class="hero-glow relative flex items-center text-white min-h-[70vh] md:min-h-[80vh]"
      style={`background-image: url('${base}images/backgrounds/hero-bg.webp'); background-size: cover; background-position: center;`}
    >
      <div class="absolute inset-0 bg-slate-950/45"></div>
      
      <div class="relative z-10 max-w-screen-2xl mx-auto px-6 py-12 md:py-16 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-7">
          <p class="hero-animate text-sky-300 text-sm font-semibold tracking-widest mb-3">CSR CONSULTING FIRM · INDIA</p>
          <h1 class="hero-animate text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter leading-tight mb-4">
            {SEO.home.h1Lead}<br />
            <span class="text-sky-400">{SEO.home.h1Accent}</span>
          </h1>
          <p class="hero-animate hero-animate-delay-1 max-w-xl text-lg text-slate-200 mb-5">
            {SEO.home.h1Sub}
          </p>

          <div class="hero-animate hero-animate-delay-2 flex flex-col sm:flex-row gap-4 mb-8">
            <a href={`${base}services/`} class="btn btn-primary px-8 py-3 text-base">
              Explore CSR Services
            </a>
            <a href={`${base}contact/`} class="btn border border-white/60 text-white px-8 py-3 text-base bg-white/10 hover:bg-white/20 backdrop-blur-sm">
              Book a Strategy Call
            </a>
          </div>
        </div>

        <!-- Hero Logo (matching original design) -->
        <div class="md:col-span-5 flex justify-center md:justify-end">
          <picture>
            <source srcset={`${base}images/logos/logo_1.webp`} type="image/webp" />
            <img 
              src={`${base}images/logos/logo_1.png`} 
              alt="Causewave" 
              width="280"
              height="280"
              class="w-[240px] md:w-[280px] drop-shadow-2xl"
            />
          </picture>
        </div>
      </div>
    </header>

    <!-- Team (locked copy — replaces homepage counters) -->
    <section class="bg-white border-b homepage-section" aria-labelledby="team-heading">
      <div class="max-w-screen-2xl mx-auto px-6">
        <span class="text-sky-600 font-semibold text-sm tracking-widest">OUR TEAM</span>
        <h2 id="team-heading" class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Our team</h2>
        <p class="mt-4 max-w-3xl text-slate-600 leading-relaxed">
          Causewave is built around practitioners who have designed, delivered and governed <strong class="font-semibold text-slate-800">CSR and philanthropic initiatives</strong> across sectors — not observers of the Act. The team has worked multi-domain and cross-domain, from flagship programmes to portfolio management, across <strong class="font-semibold text-slate-800">20+ states</strong>. Leaders bring experience from <strong class="font-semibold text-slate-800">UN agencies and international NGOs</strong>. Together they have <strong class="font-semibold text-slate-800">managed CSR and philanthropic portfolios and mobilised funds of over ₹500 crore</strong>, with the same test we bring to every engagement: regulator-safe, board-defensible, and trusted on the ground.
        </p>

        <h3 class="mt-10 text-sm font-semibold tracking-widest text-sky-600">WHAT THE TEAM HAS RUN</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
              <Icon name="building" class="w-5 h-5" />
            </div>
            <h4 class="font-semibold text-slate-900">24×7 vaccination centres</h4>
            <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Across multiple states and sites — multi-location operations, rostering, supply and real-time tracking.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
              <Icon name="stethoscope" class="w-5 h-5" />
            </div>
            <h4 class="font-semibold text-slate-900">Makeshift hospitals and surge facilities</h4>
            <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Standing up service infrastructure at speed, then running it.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
              <Icon name="users" class="w-5 h-5" />
            </div>
            <h4 class="font-semibold text-slate-900">Workforce at scale</h4>
            <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Skilled and non-skilled personnel mobilised, trained and deployed for the same operations.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
              <Icon name="handshake" class="w-5 h-5" />
            </div>
            <h4 class="font-semibold text-slate-900">Community mobilisation and awareness</h4>
            <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Demand generation, hesitancy, last-mile turnout; not a poster campaign.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
              <Icon name="chart-bar" class="w-5 h-5" />
            </div>
            <h4 class="font-semibold text-slate-900">Impact, not activity</h4>
            <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Coverage, equity and outcomes measured while the programme is running, so the board sees results, not photographs.</p>
          </article>
        </div>
      </div>
    </section>



    <!-- Services Preview -->
    <section class="homepage-section max-w-screen-2xl mx-auto px-6">
      <div class="text-center mb-10">
        <span class="text-sky-600 font-semibold text-sm tracking-widest">CORPORATE CSR & IMPACT ADVISORY</span>
        <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">CSR strategy. Programme design. Impact measurement.</h2>
        <p class="mt-3 text-slate-600 max-w-2xl mx-auto text-sm">
          Full-stack CSR consulting for companies and partners across India — from portfolio strategy and compliance to field delivery and evidence-based impact assessment.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <a href={`${base}services/`} class="card group block rounded-2xl border bg-white p-6 hover:border-sky-200">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-sky-600">
            <Icon name="chess" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-semibold">CSR Strategy & Programme Design</h3>
          <p class="mt-2 text-sm text-slate-600">Corporate CSR strategy, flagship programme design, portfolio advisory, Section 135 compliance, resource mobilisation, and stakeholder engagement.</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-sky-600 group-hover:underline">
            Strategy services →
          </span>
        </a>

        <a href={`${base}services/`} class="card group block rounded-2xl border bg-white p-6 hover:border-teal-200">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
            <Icon name="laptop-code" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-semibold">Impact Data & Technology</h3>
          <p class="mt-2 text-sm text-slate-600">CSR platforms, data integration, digital transformation, analytics, and monitoring systems that make social impact programmes measurable.</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-teal-600 group-hover:underline">
            Technology services →
          </span>
        </a>

        <a href={`${base}services/`} class="card group block rounded-2xl border bg-white p-6 hover:border-emerald-200">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
            <Icon name="sparkles" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-semibold">Impact Communication</h3>
          <p class="mt-2 text-sm text-slate-600">Impact stories, board and stakeholder videos, training content, and CSR brand storytelling — powered by AI, grounded in programme data.</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-emerald-600 group-hover:underline">
            Communication services →
          </span>
        </a>
      </div>

      <div class="mt-8 text-center">
        <a href={`${base}services/`} class="btn btn-primary px-6 py-3 text-sm">
          View All CSR Services →
        </a>
      </div>
    </section>

    <!-- Who we serve / keyword themes (competitive category coverage) -->
    <section class="homepage-section bg-slate-900 text-white">
      <div class="max-w-screen-2xl mx-auto px-6">
        <div class="text-center mb-8">
          <span class="text-sky-400 font-semibold text-sm tracking-widest">WHO WE WORK WITH</span>
          <h2 class="mt-3 text-2xl md:text-3xl font-semibold tracking-tight">Impact is a multi-stakeholder business</h2>
          <p class="mt-3 text-slate-300 text-sm max-w-2xl mx-auto">
            Like leading impact consulting firms in India, we engage corporates, non-profits, and ecosystem partners — with a differentiator in public health and last-mile delivery.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="rounded-xl border border-white/10 bg-white/5 p-5">
            <h3 class="font-semibold text-sky-300">Corporate CSR & Sustainability</h3>
            <p class="mt-2 text-sm text-slate-400">CSR strategy, compliance, flagship programmes, and portfolio governance for India Inc.</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-5">
            <h3 class="font-semibold text-teal-300">Non-profit Organisations</h3>
            <p class="mt-2 text-sm text-slate-400">Resource mobilisation, partner mapping, and proposal-to-implementation support for NGOs.</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-5">
            <h3 class="font-semibold text-emerald-300">Impact Measurement</h3>
            <p class="mt-2 text-sm text-slate-400">M&amp;E frameworks, impact assessment, dashboards, and board-ready evidence of outcomes.</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-5">
            <h3 class="font-semibold text-sky-300">Healthcare & Public Health CSR</h3>
            <p class="mt-2 text-sm text-slate-400">Programme design grounded in vaccination, surveillance, and last-mile health delivery.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- About Preview -->
    <section class="homepage-section bg-white">
      <div class="max-w-screen-2xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-sky-600 font-semibold text-sm tracking-widest">IMPACT CONSULTING · INDIA</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">
            Bridging CSR compliance and real community impact
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Causewave is a CSR consulting firm in India built for programmes that must satisfy boards, regulators, and communities.
            We combine corporate social responsibility strategy with field-tested public health leadership — 18+ years of delivery expertise across states.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The practice is led by
            <a href={`${base}insights/founder-story/`} class="text-sky-600 hover:underline">Dr. Hemant L. Patel</a>
            — from WHO surveillance to Gujarat’s SKOCH Gold Award-winning last-mile healthcare.
          </p>
          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <a href={`${base}about/`} class="inline-flex btn btn-outline px-6 py-3 text-sm">
              Learn More About Us →
            </a>
            <a href={`${base}insights/founder-story/`} class="inline-flex btn btn-outline px-6 py-3 text-sm">
              Read the founder story →
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-sky-600">18+</div>
            <div class="mt-1 text-sm font-medium text-slate-600">Years of Public Health Leadership</div>
          </div>
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-teal-600">33 Lakh+</div>
            <div class="mt-1 text-sm font-medium text-slate-600">Vaccination Doses in a Single Day</div>
          </div>
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-emerald-600">5+</div>
            <div class="mt-1 text-sm font-medium text-slate-600">States Across India</div>
          </div>
          <div class="rounded-2xl bg-slate-50 p-6">
            <div class="text-4xl font-semibold text-sky-600">SKOCH</div>
            <div class="mt-1 text-sm font-medium text-slate-600">Gold Award Winner</div>
          </div>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>


---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Terms of Service | Causewave" 
  description="Terms of service for Causewave Innovations LLP."
  ogTitle="Terms of Service | Causewave Innovations LLP"
  ogDescription="Terms of service for Causewave Innovations LLP. Read our terms and conditions for using our website and services."
  canonicalPath="terms-of-service/"
>
  <main>
    <section class="section max-w-screen-2xl mx-auto px-6">
      <div class="max-w-3xl">
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Terms of Service</h1>
        <p class="mt-2 text-sm text-slate-500">Last updated: June 2026</p>

        <div class="mt-8 space-y-6 text-slate-600 leading-relaxed">
          <section>
            <h2 class="text-xl font-semibold text-slate-800 mb-3">1. Acceptance of Terms</h2>
            <p>
              By accessing and using the Causewave website, you accept and agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our website.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-slate-800 mb-3">2. Use of Website</h2>
            <p>
              This website is provided for informational purposes only. You may not use this website for any unlawful purpose or in any way that could damage, disable, or impair the website.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-slate-800 mb-3">3. Intellectual Property</h2>
            <p>
              All content on this website, including text, graphics, logos, and images, is the property of Causewave Innovations LLP and is protected by applicable intellectual property laws.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-slate-800 mb-3">4. Disclaimer</h2>
            <p>
              The information on this website is provided "as is" without warranties of any kind. We do not guarantee the accuracy, completeness, or timeliness of the information provided.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-slate-800 mb-3">5. Limitation of Liability</h2>
            <p>
              Causewave Innovations LLP shall not be liable for any indirect, incidental, special, or consequential damages arising from your use of this website.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-slate-800 mb-3">6. Contact Us</h2>
            <p>
              For questions about these terms, please contact us at <a href="mailto:innovate@causewave.in" class="text-sky-600 hover:underline">innovate@causewave.in</a>.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

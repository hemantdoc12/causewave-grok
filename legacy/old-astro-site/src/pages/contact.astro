---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Contact Us | Causewave Innovations LLP"
  description="Ready to build CSR programs that deliver real results? Contact Causewave."
  ogTitle="Contact Causewave | CSR Consulting"
  ogDescription="Let's discuss how we can help you build compliant CSR programs."
  canonicalPath="/contact"
  activePage="contact"
>
  <!-- Hero -->
  <div class="page-header text-white py-10" style={`background-image: url('${base}contact-bg.jpg')`}>
    <div class="max-w-screen-2xl mx-auto px-6 text-center relative z-10">
      <h1 class="text-3xl sm:text-4xl md:text-4xl font-semibold tracking-tight">Get In Touch</h1>
      <p class="mt-2 text-base text-slate-300 max-w-xl mx-auto">Ready to transform your CSR approach? Let's talk.</p>
    </div>
  </div>

  <!-- Contact Form & Info -->
  <section class="max-w-screen-2xl mx-auto px-6 py-8">
    <div class="grid lg:grid-cols-12 gap-6">
      <!-- Form -->
      <div class="lg:col-span-7">
        <h2 class="text-xl font-semibold tracking-tight mb-1">Send Us a Message</h2>
        <p class="text-slate-600 text-sm mb-5">We'll get back to you within 24 hours.</p>

        <form class="space-y-4" id="contactForm">
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="firstName" class="block text-xs font-medium text-slate-600 mb-1">First Name *</label>
              <input type="text" id="firstName" name="firstName" required class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="First name">
            </div>
            <div>
              <label for="lastName" class="block text-xs font-medium text-slate-600 mb-1">Last Name *</label>
              <input type="text" id="lastName" name="lastName" required class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="Last name">
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-xs font-medium text-slate-600 mb-1">Work Email *</label>
              <input type="email" id="email" name="email" required class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="you@company.com">
            </div>
            <div>
              <label for="phone" class="block text-xs font-medium text-slate-600 mb-1">Phone Number</label>
              <input type="tel" id="phone" name="phone" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="+91 XXXXX XXXXX">
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="company" class="block text-xs font-medium text-slate-600 mb-1">Company Name</label>
              <input type="text" id="company" name="company" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="Company">
            </div>
            <div>
              <label for="designation" class="block text-xs font-medium text-slate-600 mb-1">Your Designation</label>
              <input type="text" id="designation" name="designation" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="e.g., CEO, CSR Manager">
            </div>
          </div>

          <div>
            <label for="service" class="block text-xs font-medium text-slate-600 mb-1">Service Interest *</label>
            <select id="service" name="service" required class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white">
              <option value="">Select Service</option>
              <optgroup label="CSR">
                <option value="csr-strategy">CSR Strategy & Planning</option>
                <option value="program-implementation">Program Implementation</option>
                <option value="compliance-reporting">Compliance & Reporting</option>
                <option value="impact-measurement">Impact Measurement</option>
              </optgroup>
              <optgroup label="Technology">
                <option value="software-development">Custom Software</option>
                <option value="digital-transformation">Digital Transformation</option>
                <option value="data-analytics">Data Analytics</option>
              </optgroup>
              <optgroup label="AI">
                <option value="ai-video-generation">AI Video Generation</option>
              </optgroup>
              <option value="consultation">General Consultation</option>
            </select>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="budget" class="block text-xs font-medium text-slate-600 mb-1">Budget Range</label>
              <select id="budget" name="budget" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white">
                <option value="">Select Budget</option>
                <option value="under-5l">Under ₹5 Lakhs</option>
                <option value="5l-25l">₹5 - 25 Lakhs</option>
                <option value="25l-1cr">₹25 Lakhs - 1 Crore</option>
                <option value="above-1cr">Above ₹1 Crore</option>
              </select>
            </div>
            <div>
              <label for="timeline" class="block text-xs font-medium text-slate-600 mb-1">Timeline</label>
              <select id="timeline" name="timeline" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white">
                <option value="">Select Timeline</option>
                <option value="urgent">Urgent (Within 1 month)</option>
                <option value="short-term">Short-term (1-3 months)</option>
                <option value="medium-term">Medium-term (3-6 months)</option>
                <option value="long-term">Long-term (6+ months)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-medium text-slate-600 mb-1">Project Details *</label>
            <textarea id="message" name="message" rows="3" required class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm" placeholder="Describe your project requirements..."></textarea>
          </div>

          <div class="flex items-center gap-2">
            <input type="checkbox" id="privacy" name="privacy" required class="rounded">
            <label for="privacy" class="text-xs text-slate-600">I agree to the <a href={`${base}privacy-policy`} class="text-sky-600 hover:underline" target="_blank" rel="noopener noreferrer">Privacy Policy</a> *</label>
          </div>

          <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-sky-500 to-teal-500 text-white font-semibold text-sm rounded-lg hover:shadow-lg transition-all">
            Send Message <i class="fa-solid fa-paper-plane ml-2"></i>
          </button>
          <p class="text-xs text-slate-500 text-center">We typically respond within 24 hours.</p>
        </form>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Contact Methods -->
        <div class="bg-slate-50 p-5 rounded-xl">
          <h3 class="text-base font-semibold mb-4">Contact Information</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-sky-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-envelope text-sm text-sky-600"></i>
              </div>
              <div>
                <a href="mailto:innovate@causewave.in" class="text-sm text-slate-600 hover:text-sky-600">innovate@causewave.in</a>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-teal-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-phone text-sm text-teal-600"></i>
              </div>
              <div>
                <div class="text-sm text-slate-600">+91 76005 96053</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-emerald-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-location-dot text-sm text-emerald-600"></i>
              </div>
              <div>
                <div class="text-sm text-slate-600">Ahmedabad, Gujarat, India</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Business Hours -->
        <div class="bg-slate-50 p-5 rounded-xl">
          <h3 class="text-base font-semibold mb-3">Business Hours</h3>
          <div class="space-y-1.5 text-sm">
            <div class="flex justify-between">
              <span class="text-slate-600">Mon - Fri</span>
              <span class="font-medium text-slate-900">9 AM - 6 PM</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Saturday</span>
              <span class="font-medium text-slate-900">10 AM - 2 PM</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Sunday</span>
              <span class="text-slate-500">Closed</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('contactForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const firstName = formData.get('firstName');
      const lastName = formData.get('lastName');
      const email = formData.get('email');
      const phone = formData.get('phone') || 'Not provided';
      const company = formData.get('company') || 'Not provided';
      const designation = formData.get('designation') || 'Not provided';
      const service = formData.get('service');
      const budget = formData.get('budget') || 'Not specified';
      const timeline = formData.get('timeline') || 'Not specified';
      const message = formData.get('message');

      const subject = encodeURIComponent(`New Inquiry from ${firstName} ${lastName} - ${company}`);
      const body = encodeURIComponent(
        `New Contact Form Submission\n\n` +
        `Name: ${firstName} ${lastName}\n` +
        `Email: ${email}\n` +
        `Phone: ${phone}\n` +
        `Company: ${company}\n` +
        `Designation: ${designation}\n` +
        `Service Interest: ${service}\n` +
        `Budget: ${budget}\n` +
        `Timeline: ${timeline}\n\n` +
        `Project Details:\n${message}`
      );
      
      window.location.href = `mailto:innovate@causewave.in?subject=${subject}&body=${body}`;
      
      alert('Opening your email client to send the message. Please send the email to complete your inquiry.');
      form.reset();
    });
  }
});
</script>

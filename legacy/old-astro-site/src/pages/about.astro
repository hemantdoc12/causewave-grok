---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About Us | Causewave Innovations LLP - CSR Consulting"
  description="Causewave bridges the gap between CSR compliance and real community impact."
  ogTitle="About Causewave | CSR Strategy & Impact"
  ogDescription="We help companies design, implement, and measure CSR initiatives."
  canonicalPath="/about"
  activePage="about"
>
  <!-- Hero -->
  <div class="page-header text-white py-10" style={`background-image: url('${base}about-bg.jpg')`}>
    <div class="max-w-screen-2xl mx-auto px-6 relative z-10 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-4xl font-semibold tracking-tight">Why Causewave Exists</h1>
      <p class="mt-2 text-base text-slate-300 max-w-xl mx-auto">Most CSR programs struggle to be both compliant and truly impactful. We bridge that gap.</p>
    </div>
  </div>

  <!-- Mission -->
  <div class="max-w-screen-2xl mx-auto px-6 py-8">
    <div class="text-center max-w-3xl mx-auto text-base text-slate-600 leading-relaxed space-y-4">
      <p>At Causewave, we help companies design, implement, and measure CSR initiatives that satisfy boards, regulators, and — most importantly — the communities they aim to serve.</p>
      <p>Our approach combines deep statutory knowledge with on-the-ground execution experience. We don't just write reports — we build programs that work in the real world.</p>
    </div>
  </div>

  <!-- What Sets Us Apart -->
  <section class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">OUR APPROACH</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">What sets Causewave apart</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="p-5 rounded-xl border bg-slate-50">
          <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-shield-halved text-xl text-sky-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Compliance-First Thinking</h3>
          <p class="text-slate-600 text-sm">Every recommendation starts with statutory requirements and board expectations.</p>
        </div>
        <div class="p-5 rounded-xl border bg-slate-50">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-map-location-dot text-xl text-teal-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Last-Mile Expertise</h3>
          <p class="text-slate-600 text-sm">18+ years in public health delivery across India's most challenging environments.</p>
        </div>
        <div class="p-5 rounded-xl border bg-slate-50">
          <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-database text-xl text-emerald-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Data-Driven Impact</h3>
          <p class="text-slate-600 text-sm">M&E frameworks that produce credible, quantifiable evidence of impact.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- By the Numbers -->
  <section>
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">TRACK RECORD</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">Impact by the numbers</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-4">
        <div class="bg-white border p-5 rounded-xl text-center">
          <div class="text-3xl font-bold text-sky-600 mb-1">18+</div>
          <div class="text-slate-600 text-sm font-medium">Years in Public Health</div>
        </div>
        <div class="bg-white border p-5 rounded-xl text-center">
          <div class="text-3xl font-bold text-teal-600 mb-1">33 Lakh+</div>
          <div class="text-slate-600 text-sm font-medium">Single-Day Vaccination Record</div>
        </div>
        <div class="bg-white border p-5 rounded-xl text-center">
          <div class="text-3xl font-bold text-emerald-600 mb-1">11+</div>
          <div class="text-slate-600 text-sm font-medium">States Covered</div>
        </div>
        <div class="bg-white border p-5 rounded-xl text-center">
          <div class="text-3xl font-bold text-sky-600 mb-1">SKOCH</div>
          <div class="text-slate-600 text-sm font-medium">Gold Award</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section id="leadership" class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">LEADERSHIP</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">Meet Our Founder</h2>
      </div>
      <div class="grid lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8">
          <div class="text-sm text-slate-600 leading-relaxed space-y-3">
            <p>Dr. Hemant L. Patel is a public health strategy and transformation leader with over 18 years driving government engagement, evidence-based program scale-up, and digital public health innovation across WHO, CARE India, Government of Gujarat, and WISH Foundation.</p>
            <p>He conceived and executed India's highest single-day COVID-19 vaccination achievement — enabling 33+ lakh doses in Bihar's Maha-Abhiyan — and designed Gujarat's award-winning Chitta/Cheetah Bike Express last-mile delivery model, now adopted by the Government of Gujarat and featured as an IIM Raipur case study.</p>
            <p>His WHO surveillance work in Sitamarhi identified 30+ measles outbreaks from a zero-detection baseline, transitioning the district from outbreak-based to case-based surveillance for elimination goals. At CARE India, he provided backend support across 11 states and led immunization expansion into Bihar, Jharkhand, Manipur, and Gujarat.</p>
            <p>Dr. Patel's vaccine equity analytics reduced district-level coverage variation from ±20% to ~5%, enabling more equitable access during the national rollout. He has also coordinated AI-enabled production of 100+ minutes of frontline health worker training content under a World Bank-funded Gujarat project and designed dashboards, automated reporting, and chatbot workflows for public health monitoring.</p>
            <p>A recognized voice in global health, he spoke at Biologistics World Asia 2021 on COVID-19 vaccine rollout, cold chain, and immunization supply chains. His contributions have been recognized by the Chief Minister of Gujarat for the Kayakalp initiative and felicitated by the Health Minister of Bihar for the COVID-19 Maha-Abhiyan achievement.</p>
            <p>Through Causewave, he brings this same rigor to CSR consulting — helping corporations design programs that deliver genuine, measurable impact at population scale.</p>
          </div>
        </div>
        <div class="lg:col-span-4">
          <div class="bg-slate-50 rounded-xl p-5 sticky top-16">
            <div class="w-14 h-14 bg-sky-600 text-white rounded-full flex items-center justify-center text-lg font-bold mb-3">HP</div>
            <h3 class="text-lg font-semibold mb-1">Dr. Hemant L. Patel</h3>
            <p class="text-slate-500 text-sm mb-4">Founder & CEO</p>
            <div class="space-y-3">
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Education</div>
                <div class="text-sm text-slate-700">MBBS</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Experience</div>
                <div class="text-sm text-slate-700">18+ Years in Public Health</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Record</div>
                <div class="text-sm text-slate-700">33L+ Single-Day Vaccination</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Recognition</div>
                <div class="text-sm text-slate-700">SKOCH Gold Award</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Awards</div>
                <div class="text-sm text-slate-700">CM Gujarat (Kayakalp), Health Min. Bihar</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Collaborations</div>
                <div class="text-sm text-slate-700">WHO, CARE India, Govt of Gujarat</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-sky-600 uppercase">Geography</div>
                <div class="text-sm text-slate-700">11+ States Across India</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

  description="Terms of Service for Causewave Innovations LLP"
  ogTitle="Terms of Service | Causewave"
  ogDescription="Terms of Service for Causewave Innovations LLP"
  canonicalPath="/terms-of-service"
  activePage=""
>
  <div class="max-w-screen-2xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold mb-6">Terms of Service</h1>
    <div class="prose prose-slate max-w-none text-sm text-slate-600 space-y-4">
      <p><strong>Last updated:</strong> May 29, 2026</p>
      
      <h2 class="text-xl font-semibold text-slate-900 mt-6">1. Acceptance of Terms</h2>
      <p>By accessing and using the Causewave Innovations LLP website, you accept and agree to be bound by these Terms of Service.</p>
      

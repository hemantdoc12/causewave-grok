---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-slate-900 text-slate-400 text-xs">
  <div class="max-w-screen-2xl mx-auto px-8 py-6">
    <div class="grid md:grid-cols-12 gap-y-4">
      <div class="md:col-span-6">
        <div class="flex items-center gap-x-2 mb-2">
          <img src={`${base}logo_2.png`} alt="Causewave" class="h-6 w-auto">
          <span class="text-base text-white font-semibold tracking-tighter">Causewave</span>
        </div>
        <div class="max-w-xs text-slate-400 text-xs leading-relaxed">
          Causewave Innovations LLP, Ahmedabad, Gujarat, India<br>
          <a href="mailto:innovate@causewave.in" class="hover:text-white">innovate@causewave.in</a> |
          <a href="tel:+917600596053" class="hover:text-white">+91 76005 96053</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-1 text-xs tracking-widest">COMPANY</div>
        <div class="space-y-1 text-xs">
          <a href={`${base}about`} class="block hover:text-white">About Us</a>
          <a href={`${base}about`} class="block hover:text-white">Leadership</a>
          <a href={`${base}insights`} class="block hover:text-white">Insights</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-1 text-xs tracking-widest">LEGAL</div>
        <div class="space-y-1 text-xs">
          <a href={`${base}privacy-policy`} class="block hover:text-white">Privacy Policy</a>
          <a href={`${base}terms-of-service`} class="block hover:text-white">Terms of Service</a>
        </div>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between items-center text-xs pb-2">
      <div>&copy; {new Date().getFullYear()} Causewave Innovations LLP</div>
      <div class="whitespace-nowrap">Made in India</div>
    </div>
  </div>
</footer>
